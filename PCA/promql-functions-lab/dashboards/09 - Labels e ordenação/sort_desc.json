          },
          "expr": "sort_desc(\n  sum by (service) (rate(sort_desc_http_requests_total{code=~\"5..\"}[1m]))\n    / sum by (service) (rate(sort_desc_http_requests_total[1m]))\n)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ]
    },
