                },
                "5": {
                  "text": "Sex"
                },
                "6": {
                  "text": "Sáb"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "day_of_week(day_of_week_simulated_clock_timestamp_seconds)",
          "legendFormat": "dia da semana",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
