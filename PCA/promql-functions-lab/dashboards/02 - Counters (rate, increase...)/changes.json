        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "worker"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "changes_kube_deployment_status_observed_generation{deployment!=\"legacy\"}",
          "legendFormat": "{{deployment}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
