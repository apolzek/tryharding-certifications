            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "datasource": {
