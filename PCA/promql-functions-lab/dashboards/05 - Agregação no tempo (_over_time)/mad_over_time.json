    {
      "id": 5,
      "type": "timeseries",
      "title": "4. z-score clássico vs robusto (api-java)",
      "description": "Clássico: (x−avg)/stddev → a agulha dá só ≈3.3 (os outliers 'escondem' a si mesmos). Robusto: (x−mediana)/(1.4826·MAD) → a agulha dá ≈ 85 a 165.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
