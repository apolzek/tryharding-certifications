      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(mad_over_time_probe_duration_seconds{target=\"api-java\"} - avg_over_time(mad_over_time_probe_duration_seconds{target=\"api-java\"}[5m]))\n  / stddev_over_time(mad_over_time_probe_duration_seconds{target=\"api-java\"}[5m])",
          "legendFormat": "z clássico",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
