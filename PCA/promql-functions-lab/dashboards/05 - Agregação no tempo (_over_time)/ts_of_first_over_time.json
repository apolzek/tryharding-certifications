      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - ts_of_first_over_time(ts_of_first_over_time_app_build_info[1h])) and on(version) ts_of_first_over_time_app_build_info",
          "legendFormat": "uptime da {{version}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ]
    },
